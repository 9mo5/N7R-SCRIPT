<script>
// نسخ
function copyScript(btn) {
    let text = btn.parentElement.querySelector(".code").innerText;
    navigator.clipboard.writeText(text);
    alert("تم النسخ ✅");
}

// تقييم متطور
function rate(btn, type) {
    let box = btn.closest(".script-box");
    let id = box.getAttribute("data-id");

    let likes = parseInt(localStorage.getItem(id+"_like")) || 0;
    let dislikes = parseInt(localStorage.getItem(id+"_dislike")) || 0;
    let vote = localStorage.getItem(id+"_vote");

    if (vote === type) {
        if (type === "like") likes--;
        else dislikes--;
        localStorage.removeItem(id+"_vote");
    } else if (vote) {
        if (type === "like") { likes++; dislikes--; }
        else { dislikes++; likes--; }
        localStorage.setItem(id+"_vote", type);
    } else {
        if (type === "like") likes++;
        else dislikes++;
        localStorage.setItem(id+"_vote", type);
    }

    localStorage.setItem(id+"_like", likes);
    localStorage.setItem(id+"_dislike", dislikes);

    updateUI(box, id);
}

// تحديث الشكل
function updateUI(box, id) {
    let likes = localStorage.getItem(id+"_like") || 0;
    let dislikes = localStorage.getItem(id+"_dislike") || 0;
    let vote = localStorage.getItem(id+"_vote");

    box.querySelector(".like span").innerText = likes;
    box.querySelector(".dislike span").innerText = dislikes;

    box.querySelector(".like").style.opacity = vote === "like" ? "1" : "0.5";
    box.querySelector(".dislike").style.opacity = vote === "dislike" ? "1" : "0.5";
}

// تحميل
window.onload = function() {
    document.querySelectorAll(".script-box").forEach(box => {
        let id = box.getAttribute("data-id");
        updateUI(box, id);
    });
}

// بحث
document.getElementById("search").addEventListener("keyup", function() {
    let value = this.value.toLowerCase();
    document.querySelectorAll(".script-box").forEach(box => {
        let name = box.getAttribute("data-name");
        box.style.display = name.includes(value) ? "inline-block" : "none";
    });
});
</script>

